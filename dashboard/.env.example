# Postgres connection string (set automatically when you add Neon from the Vercel Marketplace)
DATABASE_URL=

# Password for viewing the dashboard
DASHBOARD_PASSWORD=

# Optional shared secret. When set, /api/ingest requires "Authorization: Bearer <value>".
# Plugin users put the same value in CLAUDE_TRACKER_TOKEN or ~/.claude/usage-tracker/config.json.
INGEST_TOKEN=
